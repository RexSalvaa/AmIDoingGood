<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="prototype.amidoinggood.controller.DashboardController">

    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label text="Am I Doing Good?">
        <font>
            <Font name="System Bold" size="24.0"/>
        </font>
    </Label>

    <ImageView fx:id="avatarView" fitHeight="200.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true" />

    <VBox spacing="5.0" alignment="CENTER_LEFT">
        <Label text="Santé Physique" />
        <ProgressBar fx:id="healthBar" prefWidth="300.0" progress="0.5" style="-fx-accent: #e74c3c;" />

        <Label text="Intellect" />
        <ProgressBar fx:id="intellectBar" prefWidth="300.0" progress="0.5" style="-fx-accent: #3498db;" />

        <Label text="Dopamine" />
        <ProgressBar fx:id="dopamineBar" prefWidth="300.0" progress="0.5" style="-fx-accent: #f1c40f;" />
    </VBox>

    <HBox spacing="10.0" alignment="CENTER">
        <Button text="🍔 Manger Gras" onAction="#onEatBurger" style="-fx-background-color: #e67e22; -fx-text-fill: white;"/>
        <Button text="🥗 Manger Sain" onAction="#onEatSalad" style="-fx-background-color: #27ae60; -fx-text-fill: white;"/>
    </HBox>

    <HBox spacing="10.0" alignment="CENTER">
        <Button text="💻 Coder Java" onAction="#onCodeJava" style="-fx-background-color: #34495e; -fx-text-fill: white;"/>
        <Button text="📱 TikTok" onAction="#onScrollTiktok" style="-fx-background-color: #e84393; -fx-text-fill: white;"/>
    </HBox>

</VBox>