<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox prefWidth="550.0" prefHeight="900.0" spacing="10" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="prototype.amidoinggood.controller.DashboardController">
    <padding><Insets top="15" right="15" bottom="15" left="15"/></padding>

    <HBox spacing="15" alignment="CENTER_LEFT" style="-fx-background-color: #f4f4f4; -fx-padding: 15; -fx-background-radius: 10;" VBox.vgrow="NEVER">
        <ImageView fx:id="avatarView" fitHeight="110.0" fitWidth="110.0" pickOnBounds="true" preserveRatio="true" />
        <ScrollPane fitToWidth="true" fitToHeight="true" HBox.hgrow="ALWAYS" style="-fx-background-color: transparent; -fx-border-color: transparent;">
            <VBox spacing="5">
                <Label text="My Statistics" style="-fx-font-weight: bold; -fx-font-size: 14px;" />

                <VBox spacing="0"><Label text="Health" style="-fx-font-size: 10px;"/><ProgressBar fx:id="healthBar" prefWidth="300.0" prefHeight="15.0" minHeight="15.0" progress="0.5" /></VBox>
                <VBox spacing="0"><Label text="Intellect" style="-fx-font-size: 10px;"/><ProgressBar fx:id="intellectBar" prefWidth="300.0" prefHeight="15.0" minHeight="15.0" progress="0.5" /></VBox>
                <VBox spacing="0"><Label text="Dopamine" style="-fx-font-size: 10px;"/><ProgressBar fx:id="dopamineBar" prefWidth="300.0" prefHeight="15.0" minHeight="15.0" progress="0.5" /></VBox>
                <VBox spacing="0"><Label text="Exercise" style="-fx-font-size: 10px;"/><ProgressBar fx:id="exerciseBar" prefWidth="300.0" prefHeight="15.0" minHeight="15.0" progress="0.5" /></VBox>
                <VBox spacing="0"><Label text="Sleep Management" style="-fx-font-size: 10px;"/><ProgressBar fx:id="sleepBar" prefWidth="300.0" prefHeight="15.0" minHeight="15.0" progress="0.5" /></VBox>
                <VBox spacing="0"><Label text="Social" style="-fx-font-size: 10px;"/><ProgressBar fx:id="socialBar" prefWidth="300.0" prefHeight="15.0" minHeight="15.0" progress="0.5" /></VBox>
                <VBox spacing="0"><Label text="Duty" style="-fx-font-size: 10px;"/><ProgressBar fx:id="dutyBar" prefWidth="300.0" prefHeight="15.0" minHeight="15.0" progress="0.5" /></VBox>
            </VBox>
        </ScrollPane>
    </HBox>

    <Label text="Daily Tracker &amp; Data Harvest">
        <font><Font name="System Bold" size="20.0"/></font>
    </Label>
    <Separator/>

    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
        <VBox spacing="10">
            <TitledPane text="🎨 Customize My Avatar" expanded="false" style="-fx-font-weight: bold;">
                <VBox spacing="10">
                    <HBox spacing="10" alignment="CENTER_LEFT"><Label text="Skin:" prefWidth="60"/><ChoiceBox fx:id="skinChoice" prefWidth="120"/></HBox>
                    <HBox spacing="10" alignment="CENTER_LEFT"><Label text="Hair:" prefWidth="60"/><ChoiceBox fx:id="topChoice" prefWidth="120"/></HBox>
                    <HBox spacing="10" alignment="CENTER_LEFT"><Label text="Color:" prefWidth="60"/><ChoiceBox fx:id="hairColorChoice" prefWidth="120"/></HBox>
                    <HBox spacing="10" alignment="CENTER_LEFT"><Label text="Outfit:" prefWidth="60"/><ChoiceBox fx:id="clothingChoice" prefWidth="120"/></HBox>
                </VBox>
            </TitledPane>

            <TitledPane text="Health &amp; Sleep" expanded="true">
                <VBox spacing="10">
                    <HBox spacing="10" alignment="CENTER_LEFT">
                        <Label text="Bedtime:" prefWidth="60"/>
                        <TextField fx:id="sleepTimeField" promptText="23:30" prefWidth="70"/>
                        <Label text="Wake up:" prefWidth="60"/>
                        <TextField fx:id="wakeTimeField" promptText="07:30" prefWidth="70"/>
                    </HBox>

                    <VBox spacing="5">
                        <Label text="Total Hours of Sleep (0-12h)"/>
                        <Slider fx:id="sleepSlider" min="0" max="12" majorTickUnit="1" showTickLabels="true" snapToTicks="true"/>
                        <Label fx:id="sleepLabel" text="8.0h" textFill="#8e44ad" style="-fx-font-style: italic;"/>
                    </VBox>
                    <Separator/>
                    <HBox spacing="10" alignment="CENTER_LEFT"><Label text="Breakfast:" prefWidth="80"/><ChoiceBox fx:id="breakfastChoice" prefWidth="150"/></HBox>
                    <HBox spacing="10" alignment="CENTER_LEFT"><Label text="Meal 1:" prefWidth="80"/><ChoiceBox fx:id="meal1Choice" prefWidth="150"/></HBox>
                    <HBox spacing="10" alignment="CENTER_LEFT"><Label text="Meal 2:" prefWidth="80"/><ChoiceBox fx:id="meal2Choice" prefWidth="150"/></HBox>
                    <VBox spacing="5">
                        <Label text="Any extras? (How bad: 0 to 4)"/>
                        <Slider fx:id="extrasSlider" min="0" max="4" majorTickUnit="1" minorTickCount="0" showTickLabels="true" snapToTicks="true"/>
                        <Label fx:id="extrasLabel" text="0" textFill="#7f8c8d" style="-fx-font-style: italic;"/>
                    </VBox>
                </VBox>
            </TitledPane>

            <TitledPane text="Self Improvement" expanded="false">
                <VBox spacing="10">
                    <CheckBox fx:id="sportCheck" text="Sport Done?"/>
                    <VBox>
                        <Label text="Reading Time (0-12h)"/>
                        <Slider fx:id="readSlider" min="0" max="12" showTickLabels="true"/>
                        <Label fx:id="readLabel" text="0.0h" textFill="#27ae60" style="-fx-font-style: italic;"/>
                    </VBox>
                    <VBox>
                        <Label text="Smart Hobbies (0-12h)"/>
                        <Slider fx:id="hobbiesSlider" min="0" max="12" showTickLabels="true"/>
                        <Label fx:id="hobbiesLabel" text="0.0h" textFill="#27ae60" style="-fx-font-style: italic;"/>
                    </VBox>
                </VBox>
            </TitledPane>

            <TitledPane text="Professional &amp; Academic" expanded="false">
                <VBox spacing="10">
                    <VBox>
                        <Label text="Time spent studying (hours)"/>
                        <Slider fx:id="studySlider" min="0" max="12" showTickLabels="true"/>
                        <Label fx:id="studyLabel" text="0.0h" textFill="#2980b9" style="-fx-font-style: italic;"/>
                    </VBox>
                    <VBox>
                        <Label text="Personal Projects (hours)"/>
                        <Slider fx:id="projectSlider" min="0" max="12" showTickLabels="true"/>
                        <Label fx:id="projectLabel" text="0.0h" textFill="#2980b9" style="-fx-font-style: italic;"/>
                    </VBox>
                </VBox>
            </TitledPane>

            <TitledPane text="Social &amp; Relationship" expanded="false">
                <VBox spacing="10">
                    <CheckBox fx:id="friendsCheck" text="Saw Friends?"/>
                    <CheckBox fx:id="funCheck" text="Had Fun?"/>
                    <CheckBox fx:id="newPeopleCheck" text="Met New People?"/>
                    <Separator/>
                    <CheckBox fx:id="gfCheck" text="Have a Girlfriend?"/>
                    <CheckBox fx:id="laidCheck" text="Got Laid?"/>
                </VBox>
            </TitledPane>

            <TitledPane text="Self Destroying" expanded="false" style="-fx-text-fill: red;">
                <VBox spacing="10">
                    <VBox>
                        <Label text="Scrolled? (1-12h)"/>
                        <Slider fx:id="scrollSlider" min="0" max="12" showTickLabels="true"/>
                        <Label fx:id="scrollLabel" text="1.0h" textFill="#c0392b" style="-fx-font-style: italic;"/>
                    </VBox>
                    <VBox>
                        <Label text="Got Wasted? (Intensity 1-10)"/>
                        <Slider fx:id="wastedSlider" min="0" max="10" showTickLabels="true" snapToTicks="true"/>
                        <Label fx:id="wastedLabel" text="Level: 1" textFill="#c0392b" style="-fx-font-style: italic;"/>
                    </VBox>
                    <VBox>
                        <Label text="Video Games? (1-12h)"/>
                        <Slider fx:id="gamesSlider" min="0" max="12" showTickLabels="true"/>
                        <Label fx:id="gamesLabel" text="1.0h" textFill="#c0392b" style="-fx-font-style: italic;"/>
                    </VBox>
                </VBox>
            </TitledPane>

            <VBox spacing="10" style="-fx-background-color: #e8f8f5; -fx-padding: 10; -fx-background-radius: 5;">
                <Label text="How much did I achieve today of what I wanted? (%)" style="-fx-font-weight: bold;"/>
                <Slider fx:id="achievementSlider" min="0" max="100" majorTickUnit="10" showTickLabels="true" snapToTicks="true"/>
                <Label fx:id="achievementLabel" text="Achieved: 50%" textFill="#16a085" style="-fx-font-style: italic; -fx-font-weight: bold;"/>
            </VBox>

            <VBox spacing="10" style="-fx-background-color: #f0f8ff; -fx-padding: 10; -fx-background-radius: 5;">
                <Label text="How Happy Do I Feel Today? (1-10)" style="-fx-font-weight: bold;"/>
                <Slider fx:id="happinessSlider" min="1" max="10" majorTickUnit="1" showTickLabels="true" snapToTicks="true"/>
                <Label fx:id="happinessLabel" text="Mood: 1/10" textFill="#8e44ad" style="-fx-font-style: italic; -fx-font-weight: bold;"/>
            </VBox>
        </VBox>
    </ScrollPane>
    <Label fx:id="statusLabel" text="" textFill="#27ae60" style="-fx-font-style: italic; -fx-font-weight: bold;" alignment="CENTER" maxWidth="Infinity"/>

    <HBox spacing="10">
        <Button text="OPEN HISTORY" onAction="#onOpenHistory" prefHeight="40.0" style="-fx-background-color: #7f8c8d; -fx-text-fill: white; -fx-font-weight: bold;" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>

        <Button text="SAVE DRAFT" onAction="#onSaveDraft" prefHeight="40.0" style="-fx-background-color: #2980b9; -fx-text-fill: white; -fx-font-weight: bold;" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>

        <Button text="FINISH DAY" onAction="#onValidateDay" prefHeight="40.0" style="-fx-background-color: #c0392b; -fx-text-fill: white; -fx-font-weight: bold;" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
    </HBox>
</VBox>